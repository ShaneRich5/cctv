{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run lint:fix *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(npm run verify *)",
      "Bash(npm run build *)",
      "Bash(npm run check-feeds *)",
      "Bash(npm run list-streams *)",
      "Bash(npx vitest run *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-file.mjs"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
